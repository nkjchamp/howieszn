# Reference only: the preview launcher does not automatically load this file.
# Set these in the hosting dashboard. Never commit actual preview credentials.
PREVIEW_USERNAME=preview
PREVIEW_PASSWORD=

# Optional on Render: the launcher can use its built-in RENDER_EXTERNAL_URL.
# Otherwise provide an exact HTTPS origin, without a path or trailing slash.
PREVIEW_ORIGIN=https://your-preview.example

# Inject the managed database's private connection string through the host.
# Never paste actual database credentials into this example or into chat.
DATABASE_URL=
# Optional application namespace, also used to isolate integration tests.
HOWIESZN_DB_SCHEMA=howieszn
PORT=4000
HOST=0.0.0.0
